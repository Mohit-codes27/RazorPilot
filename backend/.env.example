NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://razorpilot:razorpilot@localhost:5433/razorpilot?schema=public

JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=7d

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PAYMENT_PROVIDER=simulator

FRONTEND_URL=http://localhost:3000

# Keep compose project identity stable regardless of directory name.
COMPOSE_PROJECT_NAME=razorpilot
